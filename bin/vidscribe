#!/usr/bin/env bash
# vidscribe: local multilingual speech-to-text (Qwen3-ASR 1.7B via mlx-audio).
# Usage: vidscribe <file-or-URL> [-o OUTDIR] [-l LANG] [-f txt|srt|vtt|json] [-c "hotwords"] [-m MODEL] [-v [N] | -a]
#        vidscribe <frames-dir> --at TIMES | --scan RANGES: from a previous run's video, frames (--at 494,8:14,7:50-8:50; a range gives 4) or 4x4 contact sheets (--scan 50:00-60:00 or all).
# URLs (X, YouTube, etc.) are fetched with yt-dlp. Prints the transcript path; text to stdout for txt.
# Frames are on by default when the input has a video stream (-f txt|srt). -a/--audio-only: transcript only.
# -v [N]: force frames, N evenly spaced (default 8) plus a frame at every cue with an on-screen reference
#         ("look at this", "as you can see"...) and one at the end of each distinct scene (cut detection, near-duplicates dropped),
#         at most max(40, N) total. Frame text = sentence spoken at that time, interpolated within ~30s cues.
#         Frames go to /tmp/vidscribe/frames/<name>/ (auto-pruned after 3 days) with video.<ext> (downloads moved there, local files symlinked) and index.txt (time -> frame -> start-end of spoken text -> text).
set -euo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

MODEL="${VIDSCRIBE_MODEL:-mlx-community/Qwen3-ASR-1.7B-8bit}"
OUTDIR="${VIDSCRIBE_OUTDIR:-/tmp/vidscribe/transcripts}"
# tmp is only cleared on reboot, so prune transcripts older than 3 days
[[ -d /tmp/vidscribe/transcripts ]] && find /tmp/vidscribe/transcripts -mindepth 1 -maxdepth 1 -mtime +3 -exec rm -rf {} + 2>/dev/null || true
FMT="txt"; LANG_ARG=(); CTX_ARG=(); VFLAG=0; AFLAG=0; NFRAMES=8

[[ $# -ge 1 ]] || { sed -n '2,5p' "$0"; exit 1; }
case "$1" in -h|--help) sed -n '2,5p' "$0"; exit 0;; esac
# scene ends, shared by frame mode and --scan: one 2 fps pass gives each frame a scene score and a 9x8 gray thumbnail (for dedupe)
IFS= read -r -d '' SCENES_PY <<'PY' || true
import os, re, subprocess, tempfile
def scene_ends(vid, ss=None, t=None):
    fd, scf = tempfile.mkstemp(suffix='.txt'); os.close(fd)  # metadata file: path must be filtergraph-safe
    rng = [] if ss is None else ['-ss', f'{ss:.3f}', '-t', f'{t:.3f}']  # input seek: times restart at 0
    raw = subprocess.run(['ffmpeg','-nostdin','-loglevel','error'] + rng + ['-i',vid,'-an','-vf',
        f"fps=2,scale=160:-2,select='gte(scene,0)',metadata=print:key=lavfi.scene_score:file={scf},scale=9:8,format=gray",
        '-f','rawvideo','-'], capture_output=True).stdout
    meta = open(scf).read(); os.unlink(scf)
    pts = [float(x) + (ss or 0) for x in re.findall(r'pts_time:([\d.]+)', meta)]
    score = [float(x) for x in re.findall(r'scene_score=([\d.]+)', meta)]
    nf = min(len(raw)//72, len(pts), len(score))
    def dhash(i):
        b = raw[i*72:(i+1)*72]
        return sum(1 << (r*8+c) for r in range(8) for c in range(8) if b[r*9+c] > b[r*9+c+1])
    # one frame per scene, at its last sampled frame (slide builds and typed text are complete by then);
    # skip scenes under 1 s, flat frames (black/fades), and repeats of an already kept scene
    cuts = [0] + [i for i in range(1, nf) if score[i] > 0.3] + [nf]
    ends, seen = [], []
    for a, b in zip(cuts, cuts[1:]):
        i = b - 1
        th = raw[i*72:(i+1)*72]
        if b - a < 2 or max(th) - min(th) < 12: continue
        h = dhash(i)
        if any(bin(h ^ k).count('1') <= 6 for k in seen): continue
        seen.append(h); ends.append(pts[i])
    return ends
PY
# from the video a normal run kept in its frames folder, no transcription: frames on demand (--at)
# or contact sheets to find moments the transcript gives no lead to (--scan)
if [[ "${2:-}" == "--at" || "${2:-}" == "--scan" ]]; then
  MODE="${2#--}"
  (( $# == 3 )) || { echo "usage: vidscribe <frames-dir> --at TIMES | --scan RANGES (e.g. --at 494,8:14,7:50-8:50; --scan 50:00-60:00 or all; no other flags)" >&2; exit 1; }
  D="${1%/}"; VID=""
  for f in "$D"/video.*; do [[ -e "$f" ]] && VID="$f"; break; done
  [[ -n "$VID" ]] || { echo "no video in $D (folders are pruned after 3 days; local originals may have moved): re-run vidscribe on the source" >&2; exit 1; }
  DUR="$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$VID")"
  # --at: one line per frame: seconds, mm:ss.s, file name; a range A-B gets 4 frames evenly spaced inside it
  # --scan: one line per range: start and end seconds
  TS="$(awk -v at="$3" -v d="${DUR:-0}" -v mode="$MODE" '
    function sec(s,  p, n, i, t) { n = split(s, p, ":"); t = 0; for (i = 1; i <= n; i++) t = t*60 + p[i]; return t }
    function out(t,  m, s, fn) {  # round before splitting so 119.97 names 02m00.0s, not 01m60.0s; skip duplicate names
      s = int(t*10 + 0.5)/10; m = int(s/60); s -= 60*m; fn = sprintf("at_%02dm%04.1fs.jpg", m, s)
      if (!(fn in seen)) printf "%.2f\t%02d:%04.1f\t%s\n", t, m, s, fn; seen[fn] = 1
    }
    function die(msg) { print "--" mode ": " msg > "/dev/stderr"; exit 1 }
    BEGIN {
      if (mode == "scan" && at == "all") { printf "0\t%.3f\n", d; exit }
      T = "[0-9]+(:[0-5]?[0-9]){0,2}([.][0-9]+)?"
      n = split(at, it, ","); if (n == 0) die("no times given")
      for (i = 1; i <= n; i++) {
        x = it[i]; gsub(/ /, "", x)
        if (i > 1 && x ~ /^[0-9][0-9][0-9]$/ && p ~ /^[0-9]+:[0-9]+:[0-9]+$/) die("\"" p "," x "\" looks like an srt time: use a dot (" p "." x ")")
        p = x
        if (x !~ ("^" T "(-" T ")?$")) die("bad time \"" it[i] "\" (use 494, 8:14, 1:02:05 or 7:50-8:50)")
        k = split(x, r, "-"); a = sec(r[1]); b = (k == 2) ? sec(r[2]) : a
        if (mode == "scan" && k == 1) die("\"" it[i] "\" is a single time: --scan takes ranges or all (use --at for single times)")
        if (b > d || (b == d && mode == "at")) die(it[i] " is past the end of the video (" int(d) " s)")
        if (k == 2 && b <= a) die("range " it[i] " ends before it starts")
        if (mode == "scan") printf "%.3f\t%.3f\n", a, b
        else if (k == 1) out(a); else for (j = 0; j < 4; j++) out(a + (b-a)*(j+0.5)/4)
      }
    }')"
  if [[ "$MODE" == "scan" ]]; then
    python3 - "$SCENES_PY" "$VID" "$D" "$TS" <<'PY'
import sys; exec(sys.argv.pop(1))
import glob, math, shutil
from concurrent.futures import ThreadPoolExecutor
vid, d, ranges = sys.argv[1:4]
# tiles: every scene end plus even fill so no gap exceeds G s; 4x4 sheets of WxH tiles with 2 px padding
# and 1 px margin = 1280x720 (fill gap and grid from MEASUREMENTS.md, "Scan probe")
G, W, H = 10, 318, 178
mm = lambda t: f"{int(t//60):02d}:{t%60:04.1f}"
tag = lambda t: f"{int(t//60):02d}m{int(t%60):02d}s"
tmp = tempfile.mkdtemp()
try:
    for k, line in enumerate(ranges.splitlines()):
        a, b = map(float, line.split('\t'))
        s0 = math.floor(a*2)/2  # sample on the same 0.5 s grid as a whole-video pass
        ts = sorted(t for t in scene_ends(vid, s0, b - s0) if a <= t < b)
        edges = [a] + ts + [b]
        for p, q in zip(edges, edges[1:]):
            m = math.ceil((q - p) / G) - 1
            ts += [p + (q - p)*j/(m + 1) for j in range(1, m + 1)]
        ts.sort()
        print(f"{mm(a)}-{mm(b)}: {len(ts)} tiles, {math.ceil(len(ts)/16)} sheets", file=sys.stderr)
        tdir = f"{tmp}/{k}"; os.mkdir(tdir)
        def grab(it):
            i, t = it; f = f"{tdir}/{i:04d}.jpg"
            subprocess.run(['ffmpeg','-nostdin','-loglevel','quiet','-y','-ss',f'{t:.2f}','-i',vid,'-frames:v','1','-q:v','2','-vf',
                f'scale={W}:{H}:force_original_aspect_ratio=decrease,pad={W}:{H}:(ow-iw)/2:(oh-ih)/2',f])
            return t if os.path.exists(f) and os.path.getsize(f) > 0 else None
        with ThreadPoolExecutor(4) as ex: got = list(ex.map(grab, enumerate(ts)))
        kept = []  # renumber without gaps: the image sequence input stops at a missing number
        for i, t in enumerate(got):
            if t is None: print(f"no frame at {mm(ts[i])}", file=sys.stderr); continue
            os.rename(f"{tdir}/{i:04d}.jpg", f"{tdir}/s{len(kept):04d}.jpg"); kept.append(t)
        prefix = f"{d}/scan_{tag(a)}-{tag(b)}_"
        for old in glob.glob(glob.escape(prefix) + '*.jpg'): os.unlink(old)
        if not kept: continue
        subprocess.run(['ffmpeg','-nostdin','-loglevel','error','-y','-framerate','1','-i',f'{tdir}/s%04d.jpg',
            '-vf','tile=4x4:padding=2:margin=1:color=white','-q:v','3',prefix.replace('%', '%%') + '%02d.jpg'], check=True)
        for s in range(math.ceil(len(kept)/16)):
            print(f"{prefix}{s+1:02d}.jpg\t" + ' '.join(mm(t) for t in kept[s*16:(s+1)*16]))
finally:
    shutil.rmtree(tmp)
PY
    exit 0
  fi
  while IFS=$'\t' read -r t mm fn; do
    if ffmpeg -nostdin -loglevel quiet -y -ss "$t" -i "$VID" -frames:v 1 -q:v 3 -vf scale=-2:720 "$D/$fn" && [[ -s "$D/$fn" ]]; then
      printf '%s\t%s\n' "$mm" "$D/$fn"
    else echo "no frame at $mm" >&2; fi
  done <<< "$TS"
  exit 0
fi
SRC="$1"; shift
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) OUTDIR="$2"; shift 2;;
    -l) LANG_ARG=(--language "$2"); shift 2;;
    -f) FMT="$2"; shift 2;;
    -c) CTX_ARG=(--context "$2"); shift 2;;
    -m) MODEL="$2"; shift 2;;
    -v) VFLAG=1; if [[ "${2:-}" =~ ^[0-9]+$ ]]; then NFRAMES="$2"; shift 2; else shift; fi;;
    -a|--audio-only) AFLAG=1; shift;;
    *) echo "unknown arg: $1" >&2; exit 1;;
  esac
done
(( VFLAG && AFLAG )) && { echo "-v and -a conflict" >&2; exit 1; }
# frames by default for video, unless -a or a format frames can't produce (vtt/json keep the old audio-only output)
WANT_VIDEO=$VFLAG
(( ! VFLAG && ! AFLAG )) && [[ "$FMT" == "txt" || "$FMT" == "srt" ]] && WANT_VIDEO=1

# true if the file has a real video stream (cover art on mp3/m4a is an attached_pic, not video)
has_video() {
  # one value per line: csv appends a field per side_data entry ("0,"), which hid video streams
  local d; d="$(ffprobe -v error -select_streams v -show_entries stream_disposition=attached_pic -of default=nw=1:nk=1 "$1" 2>/dev/null || true)"
  [[ $'\n'"$d"$'\n' == *$'\n0\n'* ]]
}

mkdir -p "$OUTDIR"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

if [[ "$SRC" =~ ^https?:// ]]; then
  if (( WANT_VIDEO )); then
    # sources without video fall back to "b" (audio only, any extension); has_video decides below
    IN="$(yt-dlp -q --no-warnings --no-simulate --print after_move:filepath \
      -f "bv*[height<=720]+ba/b[height<=720]/b" --merge-output-format mp4 -o "$TMP/%(id)s.%(ext)s" "$SRC")"
    IN="${IN%%$'\n'*}"  # first file only if the URL is a playlist
  else
    yt-dlp -q --no-warnings -x --audio-format wav -o "$TMP/%(id)s.%(ext)s" "$SRC" >&2
    IN="$(ls "$TMP"/*.wav | head -1)"
  fi
  NAME="$(basename "${IN%.*}")"
else
  [[ -f "$SRC" ]] || { echo "no such file: $SRC" >&2; exit 1; }
  IN="$SRC"; NAME="$(basename "${SRC%.*}")"
fi
VISUAL=$VFLAG
(( WANT_VIDEO && ! VFLAG )) && has_video "$IN" && VISUAL=1

WAV="$TMP/in16k.wav"
ffmpeg -nostdin -loglevel error -y -i "$IN" -ac 1 -ar 16000 "$WAV"
DUR="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$WAV")"

OUT="$OUTDIR/$NAME"
RUNFMT="$FMT"; (( VISUAL )) && RUNFMT="srt"
# mlx-audio spends one --max-tokens budget (default 8192) on the whole file: dense speech ran out
# after ~13-55 min, and a repetition loop ("oh, oh, ..." over applause) could burn it all. So give the
# file a budget that never binds, and cap each ~30 s piece at 25 tok/s instead (real speech peaks ~16).
MLXPY="$(sed -n '1s/^#!//p' "$(command -v mlx_audio.stt.generate)")"
MAXTOK="$(awk -v d="$DUR" 'BEGIN{ printf "%d", 8192 + 32*d }')"
"$MLXPY" - --model "$MODEL" --audio "$WAV" --output-path "$OUT" --format "$RUNFMT" --max-tokens "$MAXTOK" \
  ${LANG_ARG[@]+"${LANG_ARG[@]}"} ${CTX_ARG[@]+"${CTX_ARG[@]}"} >&2 <<'PY'
import sys
from mlx_audio.stt.generate import main
try:
    from mlx_audio.stt.models.qwen3_asr.qwen3_asr import Qwen3ASRModel as M
    piece = M._generate_single_chunk
    def capped(self, audio, *, max_tokens, **kw):
        return piece(self, audio, max_tokens=min(max_tokens, 32 + int(25 * len(audio) / self.sample_rate)), **kw)
    M._generate_single_chunk = capped
except (ImportError, AttributeError) as e:
    print(f"warning: mlx-audio changed, per-piece token cap off ({e})", file=sys.stderr)
sys.argv[0] = "mlx_audio.stt.generate"
main()
PY

if (( VISUAL )); then
  # media is bulky: keep it in /tmp (cleared on reboot) and prune runs older than 3 days
  FROOT="${VIDSCRIBE_FRAMES_DIR:-/tmp/vidscribe/frames}"; mkdir -p "$FROOT"
  find "$FROOT" -mindepth 1 -maxdepth 1 -type d -mtime +3 -exec rm -rf {} + 2>/dev/null || true
  FDIR="$FROOT/$NAME"; rm -rf "$FDIR"; mkdir -p "$FDIR"
  # keep the video next to the frames: link local files (no multi-GB copy), move downloads out of $TMP
  VID="$FDIR/video.${IN##*.}"
  if [[ "$IN" == "$TMP"/* ]]; then mv "$IN" "$VID"; else ln -s "$(cd "$(dirname "$IN")" && pwd)/$(basename "$IN")" "$VID"; fi
  python3 - "$SCENES_PY" "$OUT.srt" "$DUR" "$NFRAMES" "$FDIR" "$VID" "$OUT.txt" <<'PY' >&2
import re, subprocess, sys; exec(sys.argv.pop(1))
srt, dur, n, fdir, vid, txt = sys.argv[1], float(sys.argv[2]), int(sys.argv[3]), sys.argv[4], sys.argv[5], sys.argv[6]
def sec(t):
    h, m, s = t.replace(',', '.').split(':'); return int(h)*3600 + int(m)*60 + float(s)
cues = []
for blk in re.split(r'\n\s*\n', open(srt, encoding='utf-8').read().strip()):
    lines = blk.strip().splitlines()
    for i, l in enumerate(lines):
        if '-->' in l:
            a, b = [x.strip() for x in l.split('-->')]
            cues.append((sec(a), sec(b), ' '.join(lines[i+1:]).strip())); break
open(txt, 'w', encoding='utf-8').write('\n'.join(c[2] for c in cues) + '\n')
DEIX = re.compile(r"\b(look at (this|that|here|the)|as you can see|you can see|see (this|here|that)|this (one|screen|chart|graph|slide|button|page|part)|right here|over here|on (the )?screen|watch (this|what)|let me show|i'?ll show|showing you|here'?s (the|what|how)|like this|this is what|on the (right|left)|(this|the) (photo|image|picture|plot|diagram|demo|code|graph)|up here|down here|pointing)\b|这个|这里|你看|看这", re.I)
# cues are ~30s chunks; split into sentences and interpolate each sentence's time
# by character offset so frames map to the line actually spoken, not the whole chunk
sents = []
for a, b, t in cues:
    parts = [x for x in re.split(r'(?<=[.!?])\s+|(?<=[。！？])(?![。！？])\s*', t) if x.strip()] or [t]
    total = sum(len(x) for x in parts) or 1; pos = 0
    for x in parts:
        s0 = a + (b-a)*pos/total; pos += len(x); s1 = a + (b-a)*pos/total
        sents.append((s0, s1, x.strip()))
def mmss(t): return f"{int(t//60):02d}:{t%60:04.1f}"
def around(t, w=1):
    i = next((k for k, s in enumerate(sents) if s[0] <= t < s[1]), None)
    if i is None: return '-', ''  # no spoken sentence in a gap or beyond the transcript
    win = sents[max(0, i-w):i+w+1]
    return f"{mmss(win[0][0])}-{mmss(win[-1][1])}", ' '.join(s[2] for s in win)
refs = [s0 + min(1.0, (s1-s0)/2) for s0, s1, x in sents if DEIX.search(x) and s1 > s0]  # stay inside even a sub-second sentence
scenes = [t for t in scene_ends(vid) if all(abs(t - r) >= 3 for r in refs)]
def thin(xs, k): return xs if len(xs) <= k else [xs[int((i+0.5)*len(xs)/k)] for i in range(k)]
# cap total frames (see MEASUREMENTS.md): keep all even frames; refs and scenes split the rest,
# either side's unused share goes to the other, and each is thinned evenly over time
evens = [dur*(i+0.5)/n for i in range(n)] if dur > 0 else []
cap = max(40, n); room = cap - len(evens)
r = min(len(refs), max(room//2, room - len(scenes))); s = min(len(scenes), room - r)
if len(refs) + len(scenes) > room:
    print(f"frames: capped at {cap}, kept {r} of {len(refs)} on-screen refs, {s} of {len(scenes)} scene changes")
refs, scenes = thin(refs, r), thin(scenes, s)
targets = [(t, 'ref') for t in refs] + [(t, 'scene') for t in scenes]
targets += [(t, 'even') for t in evens if all(abs(t - y) >= 3 for y, _ in targets)]
targets.sort()
idx = []
for k, (t, kind) in enumerate(targets):
    fn = f"{k:03d}_{int(t//60):02d}m{t%60:04.1f}s_{kind}.jpg"
    subprocess.run(['ffmpeg','-nostdin','-loglevel','error','-y','-ss',f'{t:.2f}','-i',vid,'-frames:v','1','-q:v','3','-vf','scale=-2:720',f"{fdir}/{fn}"], check=False)
    span, text = around(t, 0 if kind == 'ref' else 1)
    idx.append(f"{mmss(t)}\t{fn}\t{span}\t{text}")
open(f"{fdir}/index.txt", 'w', encoding='utf-8').write('\n'.join(idx) + '\n')
print(f"frames: {fdir} ({len(refs)} on-screen refs, {len(scenes)} scene changes, {sum(1 for x in targets if x[1]=='even')} evenly spaced)")
PY
  [[ "$FMT" != "srt" && "$FMT" != "txt" ]] && echo "note: -v writes srt+txt; -f $FMT ignored" >&2
  [[ "$FMT" == "srt" ]] || FMT="txt"
fi

# truncation check: model has silently stopped early on long media before
if [[ -f "$OUT.srt" ]]; then
  LAST="$(awk '/-->/ {split($0,a,"-->"); split(a[2],t,/[:,]/); last=t[1]*3600+t[2]*60+t[3]+t[4]/1000} END {print last+0}' "$OUT.srt")"
  awk -v l="${LAST:-0}" -v d="$DUR" 'BEGIN{ if (d-l > 30) printf "WARNING: last cue %.0fs < duration %.0fs; transcript ends early\n", l, d }' >&2
fi

echo "transcript: $OUT.$FMT" >&2
[[ "$FMT" == "txt" ]] && cat "$OUT.$FMT"
exit 0
